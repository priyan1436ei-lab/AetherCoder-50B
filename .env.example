# AetherCoder Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# API Server Configuration
# ==============================================================================
# Secret API key required for Bearer authentication.
# In local development mode, you can enable anonymous access with AETHERCODER_ALLOW_ANONYMOUS=1.
AETHERCODER_API_KEY=your-secure-api-key-here
AETHERCODER_ALLOW_ANONYMOUS=0

# Server host and port
AETHERCODER_HOST=0.0.0.0
AETHERCODER_PORT=8000

# Allowed CORS origins (comma-separated). Use specific origins in production.
AETHERCODER_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Optional model checkpoint to load at startup (leave blank for default untrained prototype)
# AETHERCODER_CHECKPOINT=checkpoints/prototype_150m_final.pt

# ==============================================================================
# Autonomous Coding Agent Configuration
# ==============================================================================
# Maximum number of repair attempts before aborting
AETHERCODER_AGENT_MAX_RETRIES=3

# Workspace directory for sandboxed operations
AETHERCODER_AGENT_WORKSPACE=./workspace

# Command execution timeout in seconds
AETHERCODER_AGENT_TIMEOUT=30
